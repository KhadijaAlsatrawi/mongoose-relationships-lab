<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category List</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Category List</h1>
    <a href="/categories/new">Create a new category</a>
