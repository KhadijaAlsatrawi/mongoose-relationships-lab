<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Listing Details</h1>
    <p>Street Address: <%= listing.streetAddress %></p>
    <p>City: <%= listing.city %></p>
    <p>Price: <%= listing.price %></p>
    <p>Size: <%= listing.size %></p>
    <p>Owner: <%= listing.owner.username %></p>
    <p>Category: <%= listing.category.categoryName %></p>

    <a href="/listings/<%= listing._id %>/edit">Edit Details</a>

    <form action="/listings/<%= listing._id %>/delete?_method=DELETE" method="post">
        <button>Delete Listing</button>
    </form>
</body>
</html>