<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Edit Listing</h1>
    <form action="/listings/<%= listing._id %>/edit?_method=PUT" method="post">
        <div>
        <label for="streetAddress">Street Address: </label>
        <input 
        name="streetAddress"
        id="streetAddress"
        type="text"
        required
        value="<%= listing.streetAddress %>">
        </div>

        <div>
        <label for="city">City: </label>
        <input 
        name="city"
        id="city"
        type="text"
        required
        value="<%= listing.city %>">
        </div>

        <div>
        <label for="price">Price: </label>
        <input 
        name="price"
        id="price"
        type="number"
        required
        value="<%= listing.price %>">
        </div>

        <div>
        <label for="size">Size: </label>
        <input 
        name="size"
        id="size"
        type="text"
        required
        value="<%= listing.size %>">
        </div>

        <div>
        <label for="owner">Owner: </label>
        <select name="owner" id="owner" required
        value="<%= listing.owner %>">
            <% for(let oneUser of users){ %>
                <option value="<%= oneUser._id %>"> <%= oneUser.username %> </option>
            <% } %>
        </select>
        </div>

        <div>
        <label for="category">Category: </label>
        <select name="category" id="category" required
        value="<%= listing.category %>">
            <% for(let oneCategory of categories){ %>
                <option value="<%= oneCategory._id %>"> <%= oneCategory.categoryName %> </option>
            <% } %>
        </select>
        </div>


        <button type="submit">Edit Listing</button>
    </form>
</body>
</html>