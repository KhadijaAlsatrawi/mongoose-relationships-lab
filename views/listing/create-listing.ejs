<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Listing</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>New Listing</h1>
    <form action="/listings" method="post">
        <div>
        <label for="streetAddress">Street Address: </label>
        <input 
        name="streetAddress"
        id="streetAddress"
        type="text"
        required>
        </div>

        <div>
        <label for="city">City: </label>
        <input 
        name="city"
        id="city"
        type="text"
        required>
        </div>

        <div>
        <label for="price">Price: </label>
        <input 
        name="price"
        id="price"
        type="number"
        required>
        </div>

        <div>
        <label for="size">Size: </label>
        <input 
        name="size"
        id="size"
        type="text"
        required>
        </div>

        <div>
        <label for="owner">Owner: </label>
        <select name="owner" id="owner" required>
            <% for(let oneUser of users){ %>
                <option value="<%= oneUser._id %>"> <%= oneUser.username %> </option>
            <% } %>
        </select>
        </div>

        <div>
        <label for="category">Category: </label>
        <select name="category" id="category" required>
            <% for(let oneCategory of categories){ %>
                <option value="<%= oneCategory._id %>"> <%= oneCategory.categoryName %> </option>
            <% } %>
        </select>
        </div>


        <button type="submit">Create Listing</button>
    </form>
</body>
</html>